events {}

http {
    server {
        listen 443 ssl;
        server_name _;

        ssl_certificate     /etc/nginx/ssl/server.crt;
        ssl_certificate_key /etc/nginx/ssl/server.key;

        location = /health {
            access_log off;
            return 200 "OK\n";
        }

        location / {
            root /var/www/html;
            index index.html;
        }
    }

    include /etc/nginx/conf.d/acme.conf;
}