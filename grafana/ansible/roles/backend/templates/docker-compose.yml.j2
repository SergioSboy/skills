x-prometheus-env: &prometheus-env
  PROMETHEUS_EXPORTER_HOST: prometheus_exporter
  PROMETHEUS_EXPORTER_PORT: 9394

services:
  nginx:
    image: nginx:stable-alpine
    restart: always
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf
    networks:
      - production

  app:
    image:  seregaant/lab:latest
    restart: always
    volumes:
      - ./logs:/app/log
    env_file: .env
    environment:
      <<: *prometheus-env
    expose:
      - "3000"
    depends_on:
      - app_db
      - redis
      - prometheus_exporter
    command: bash -c "rm -f /usr/src/tmp/pids/server.pid && bundle exec rails server -b '0.0.0.0'"
    networks:
      - production

  prometheus_exporter:
      image: seregaant/lab:latest
      restart: always
      environment:
        <<: *prometheus-env
      command: bundle exec prometheus_exporter --port 9394 --bind 0.0.0.0
      ports:
        - "9394:9394"
      networks:
        - production

  app_db:
    image: postgres:17-alpine
    restart: always
    volumes:
      - postgres_db:/var/lib/postgresql/data
    environment:
      POSTGRES_USER: ${DATABASE_USER}
      POSTGRES_PASSWORD: ${DATABASE_PASSWORD}
      POSTGRES_DB: ${DATABASE_NAME}
    networks:
      - production

  redis:
    image: redis:alpine
    restart: always
    volumes:
      - app_redis:/data
    networks:
      - production

  app_sidekiq:
    image: seregaant/lab:latest
    container_name: app_sidekiq
    restart: always
    volumes:
      - ./logs:/app/log
    command: sh -c "bundle exec sidekiq -q default -c 4 >> /app/log/sidekiq.log 2>&1"
    depends_on:
      - app
      - redis
      - app_db
    env_file: .env
    environment:
      <<: *prometheus-env
    networks:
      - production

  node_exporter:
    image: prom/node-exporter:v1.8.2
    container_name: node_exporter
    restart: always
    command:
      - '--path.rootfs=/host'
      - '--path.procfs=/host/proc'
      - '--path.sysfs=/host/sys'
      - '--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)'
    volumes:
      - /:/host:ro,rslave
    network_mode: host
    pid: host

volumes:
  postgres_db:
  app_redis:

networks:
  production:
    external: true