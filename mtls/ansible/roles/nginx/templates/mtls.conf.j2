server {
    listen 8443 ssl;
    server_name _;

    ssl_certificate     /etc/ssl/mtls/certs/server.crt;
    ssl_certificate_key /etc/ssl/mtls/certs/server.key;

    ssl_protocols TLSv1.2 TLSv1.3;

    # Требуем клиентский сертификат
    ssl_client_certificate /etc/nginx/certs/ca.crt;
    ssl_verify_client on;

    location = /health {
            access_log off;
            return 200 "OK\n";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
    }
}