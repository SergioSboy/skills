vrrp_script check_nginx {
    script "/usr/bin/curl -fs http://127.0.0.1/health"
    interval 2
    timeout 2
    weight -20
    fall 2
    rise 2
}

vrrp_instance VI_1 {
    state {{ keepalived_state }}
    interface {{ keepalived_interface }}

    virtual_router_id 51
    priority {{ keepalived_priority }}
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_password }}
    }

    virtual_ipaddress {
        {{ keepalived_vip }}
    }

    track_script {
        check_nginx
    }

    notify_master "/usr/local/bin/keepalived-notify.sh"
    notify_backup "/usr/local/bin/keepalived-notify.sh"
    notify_fault "/usr/local/bin/keepalived-notify.sh"
}